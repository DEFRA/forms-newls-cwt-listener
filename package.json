{
  "name": "forms-transmit-listener",
  "version": "0.0.0",
  "description": "forms-adaptor-template",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development run-p server:watch mock-api",
    "mock-api": "npm start --prefix mock-api-receiver",
    "dev:debug": "NODE_ENV=development npm run server:debug",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"**/*.{cjs,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{cjs,js,json,md}\"",
    "git:pre-commit-hook": "npm run format:check && npm run lint && npm run type-check && npm test",
    "type-check": "tsc --noEmit -p jsconfig.json",
    "lint": "eslint --cache --cache-strategy content --ignore-pattern \"auto-fill/**\" \"**/*.{cjs,js}\" && npm run type-check",
    "lint:fix": "npm run lint -- --fix",
    "mapping:gaps": "node scripts/detect-mapping-gaps.js",
    "mapping:gaps:all": "node scripts/detect-mapping-gaps.js --mapping mappings/advice-cwt.mapping.json --form form-definitions/advice.json && node scripts/detect-mapping-gaps.js --mapping mappings/assent-cwt.mapping.json --form form-definitions/assent.json && node scripts/detect-mapping-gaps.js --mapping mappings/consent-cwt.mapping.json --form form-definitions/consent.json",
    "postinstall": "npm run setup:husky",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --ext js,json --watch src --legacy-watch ./src",
    "server:watch": "nodemon --inspect=0.0.0.0 --ext js,json --watch src --legacy-watch ./src",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "start": "NODE_ENV=production node --use-strict .",
    "test": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1062.0",
    "@defra/forms-engine-plugin": "4.15.0",
    "@defra/forms-model": "3.0.675",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/hapi": "21.4.9",
    "aws-embedded-metrics": "4.2.1",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "3.0.1",
    "joi": "17.13.3",
    "node-fetch": "3.3.2",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "undici": "8.3.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.7",
    "@types/convict": "6.1.6",
    "@types/global-agent": "3.0.0",
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.8",
    "aws-sdk-client-mock": "4.1.0",
    "aws-sdk-client-mock-vitest": "7.1.0",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "neostandard": "0.12.2",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "vitest": "4.1.8",
    "vitest-fetch-mock": "0.4.5"
  }
}
